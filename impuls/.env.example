# Impuls (Serverless Functions) - environment template
# Copy to .env and adjust. Every value below has a working default in
# docker-compose.yml, so an empty .env still starts a usable dev stack.

# Port the Impuls API is published on
IMPULS_API_PORT=8080

# Metadata store (the bundled postgres service)
IMPULS_DB_USER=impuls
IMPULS_DB_PASSWORD=impuls123
IMPULS_DB_NAME=impuls

# Where function code and images live inside the container
IMPULS_DATA_DIR=/var/lib/impuls

# Storage backend: "postgres" or "file"
IMPULS_STORAGE_TYPE=postgres

# Where Impuls reports invocations back to the Strapi dashboard.
# Leave the shared secret empty to disable signature checking in development.
STRAPI_INVOCATION_REPORT_URL=http://backend-dashboard:1337/api/functions/invocation-report
IMPULS_REPORT_SECRET=

# Only read by the Go test suite; unset means those tests skip.
# TEST_DATABASE_URL=postgres://impuls:impuls123@localhost:5432/impuls?sslmode=disable
