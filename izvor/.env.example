# Example environment file for Izvor
# Copy this to .env and configure for your environment

# API Server Port
IZVOR_API_PORT=8082

# Proxmox VE Configuration
# URL of your Proxmox VE server (required)
PROXMOX_URL=https://proxmox.local:8006

# Authentication - use either password OR token-based auth
#
# IMPORTANT: a non-empty PROXMOX_PASSWORD makes the client authenticate during
# startup, and the process exits if the cluster is unreachable. Leave it empty
# until you have a real Proxmox endpoint - the API then boots in a degraded
# state and /health reports "unhealthy" instead of crash-looping.
#
# Option 1: Password authentication
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=

# Option 2: API Token authentication (recommended for production)
# Create a token in Proxmox: Datacenter > Permissions > API Tokens
# PROXMOX_TOKEN_ID=root@pam!izvor
# PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Default node for VM operations (optional, will auto-discover if not set)
PROXMOX_NODE=pve

# Skip TLS certificate verification (set to false in production)
PROXMOX_INSECURE=true
