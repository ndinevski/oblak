# Example environment file for Izvor
# Copy this to .env and configure for your environment

# API Server Port
IZVOR_API_PORT=8082

# Simulator mode
# Set to true to run Izvor against a built-in in-memory simulator instead of a
# real Proxmox cluster. The full VM lifecycle (create, start, stop, snapshot,
# delete) works end to end with no Proxmox, which is ideal for development,
# demos and CI. PROXMOX_URL is not required in this mode. Never use it as a
# stand-in for a real cluster in production.
IZVOR_SIMULATE=false

# Capacity planning
# Before provisioning, Izvor checks the target node's real resources so a create
# cannot exceed what the hardware can back. CPU and memory allow overcommit
# (time-shared / balloonable); disk is a hard limit against real free storage.
# This is a physical backstop that complements the dashboard's per-user quotas.
IZVOR_CAPACITY_CHECK=true
IZVOR_CPU_OVERCOMMIT=4.0
IZVOR_MEM_OVERCOMMIT=1.5

# Proxmox VE Configuration
# URL of your Proxmox VE server (required unless IZVOR_SIMULATE=true)
PROXMOX_URL=https://proxmox.local:8006

# Authentication - use either password OR token-based auth
#
# IMPORTANT: a non-empty PROXMOX_PASSWORD makes the client authenticate during
# startup, and the process exits if the cluster is unreachable. Leave it empty
# until you have a real Proxmox endpoint - the API then boots in a degraded
# state and /health reports "unhealthy" instead of crash-looping.
#
# Option 1: Password authentication
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=

# Option 2: API Token authentication (recommended for production)
# Create a token in Proxmox: Datacenter > Permissions > API Tokens
# PROXMOX_TOKEN_ID=root@pam!izvor
# PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Default node for VM operations (optional, will auto-discover if not set)
PROXMOX_NODE=pve

# Skip TLS certificate verification (set to false in production)
PROXMOX_INSECURE=true
