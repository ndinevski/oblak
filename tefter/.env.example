# Tefter (Database Service) - environment template
# Copy to .env and adjust. Every value has a working default.

# Port the Tefter API is published on
TEFTER_API_PORT=8084

# Host port range allocated to provisioned database instances. Each instance
# takes one port from this range, so it bounds how many can run at once.
TEFTER_PORT_RANGE_START=15000
TEFTER_PORT_RANGE_END=15099

# Address clients use to reach a provisioned database. Set this to the host's
# LAN address when connecting from another machine, e.g. 192.168.1.83.
TEFTER_PUBLIC_HOST=localhost

# Network the instance containers join. A replica reaches its primary by
# container name over this network.
TEFTER_NETWORK=tefter-network

# Where backups are written inside the Tefter container.
TEFTER_BACKUP_DIR=/var/lib/tefter/backups

# Host docker group id, needed to read docker.sock.
# Find yours with: getent group docker | cut -d: -f3
DOCKER_GID=989

# --- Telemetry --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=oblak-otel-collector:4317
OBLAK_ENV=development

# How often each database instance is polled for stats (min 5s).
TEFTER_STATS_INTERVAL_SECONDS=30
