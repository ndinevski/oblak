# Oblak Cloud Dashboard - Backup Configuration
# PostgreSQL backup with retention policies

# Backup schedule (cron format)
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM

# Retention settings
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_WEEKS=12
BACKUP_RETENTION_MONTHS=12

# Storage settings
BACKUP_DIR=/backups
BACKUP_S3_BUCKET=oblak-backups
BACKUP_S3_REGION=us-east-1

# Encryption (optional)
BACKUP_ENCRYPTION_KEY=/secrets/backup-key.gpg

# Notification settings
BACKUP_NOTIFY_EMAIL=admin@example.com
BACKUP_NOTIFY_SLACK_WEBHOOK=

# Database connection (from environment)
# POSTGRES_HOST
# POSTGRES_PORT
# POSTGRES_USER
# POSTGRES_PASSWORD
# POSTGRES_DB
