# Brod (Container Service) - environment template
# Copy to .env and adjust. Every value has a working default.

# Port the Brod API is published on
BROD_API_PORT=8083

# Port the image registry is published on. This is what `docker push` targets.
BROD_REGISTRY_PORT=5000

# Where Brod itself reaches the registry (over the compose network).
REGISTRY_URL=http://brod-registry:5000

# What users put in an image reference. Must be reachable from wherever
# `docker push` runs, so set it to the host's LAN address when pushing from
# another machine, e.g. 192.168.1.83:5000.
BROD_REGISTRY_PUBLIC_HOST=localhost:5000

# Registry credentials. Empty means the registry is unauthenticated, which is
# only appropriate on a trusted network.
BROD_REGISTRY_USERNAME=
BROD_REGISTRY_PASSWORD=

# Host docker group id, needed to read docker.sock.
# Find yours with: getent group docker | cut -d: -f3
DOCKER_GID=989

# --- Telemetry --------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=oblak-otel-collector:4317
OBLAK_ENV=development
