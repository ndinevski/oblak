# --- Red (Message Queue) ---------------------------------------------------
RED_API_PORT=8087
RED_DATA_FILE=/var/lib/red/red.db
RED_BACKUP_DIR=/var/lib/red/backups
# How often visibility timeouts, dead-lettering and retention are enforced.
RED_SWEEP_INTERVAL_SECONDS=5

OTEL_EXPORTER_OTLP_ENDPOINT=oblak-otel-collector:4317
OBLAK_ENV=development

# Impuls trigger dispatcher (SQS->Lambda pattern). Unset to disable.
RED_IMPULS_URL=http://impuls-dev:8080
RED_DISPATCH_INTERVAL_SECONDS=2
# Invoke functions in Impuls local mode (no Firecracker).
RED_IMPULS_LOCAL=false
