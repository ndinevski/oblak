# Oblak Observability Stack - environment template
# Copy to .env and adjust. Every value below has a working default.

# Which environment tag every signal is stamped with (development/staging/production)
OBLAK_ENV=development

# --- ClickHouse -------------------------------------------------------------
CLICKHOUSE_DB=otel
CLICKHOUSE_USER=oblak
CLICKHOUSE_PASSWORD=change-this-clickhouse-password

# HTTP interface, used by the Strapi telemetry query API.
CLICKHOUSE_HTTP_PORT=8123

# Native protocol. NOT 9000: MinIO/Spomen already publishes that port on this
# host, so ClickHouse's native port is remapped.
CLICKHOUSE_NATIVE_PORT=9010

# --- OpenTelemetry Collector ------------------------------------------------
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# How long every signal is retained before ClickHouse drops it (720h = 30 days).
OTEL_TTL=720h

# Browser RUM posts OTLP straight from the user's browser. The collector's
# allowed origins are listed in otel-collector/config.yaml under
# receivers.otlp.protocols.http.cors - add your dashboard origin there too.
RUM_ALLOWED_ORIGINS=http://localhost:5174

# Host docker group id, needed by the collector to read docker.sock for
# container metrics. Find yours with: getent group docker | cut -d: -f3
DOCKER_GID=989

# --- Postgres metrics -------------------------------------------------------
# The collector scrapes each Oblak Postgres for connection counts, cache hit
# ratio and table/index statistics. Values must match each service's own
# database configuration.
PG_DASHBOARD_USER=oblak
PG_DASHBOARD_PASSWORD=oblak_password
PG_DASHBOARD_DB=oblak_dashboard

PG_IMPULS_USER=impuls
PG_IMPULS_PASSWORD=impuls123
PG_IMPULS_DB=impuls

PG_POLAROID_USER=polaroid
PG_POLAROID_PASSWORD=change-this-secret-password
PG_POLAROID_DB=polaroid
