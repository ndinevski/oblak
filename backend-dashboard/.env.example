# Strapi
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# Security Keys (generate with: openssl rand -base64 32)
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified

# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=oblak_dashboard
DATABASE_USERNAME=oblak
DATABASE_PASSWORD=oblak
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# External Services
IMPULS_URL=http://localhost:8080
IMPULS_LOCAL_INVOKE_DEFAULT=false
IMPULS_REPORT_SECRET=
IZVOR_URL=http://localhost:8082
SPOMEN_URL=http://localhost:8081
POLAROID_URL=http://localhost:2283

# Service API Keys (optional)
IMPULS_API_KEY=
IZVOR_API_KEY=
SPOMEN_API_KEY=
POLAROID_API_KEY=

# JWT Settings
JWT_EXPIRES_IN=7d

# Demo Seed Data (dev bootstrap)
SEED_DEMO_DATA=true
SEED_DEMO_EMAIL=demo@oblak.local
SEED_DEMO_USERNAME=demo
SEED_DEMO_PASSWORD=DemoPass123!
SEED_DEMO_ORGANIZATION=Oblak Demo
# Optional: set true to overwrite existing demo password on every boot
SEED_RESET_DEMO_PASSWORD=false

# Email / SMTP Settings (for password reset)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=noreply@oblak.local
EMAIL_REPLY_TO=support@oblak.local

# --- OpenTelemetry ---------------------------------------------------------
# OTLP HTTP endpoint of the Oblak collector. Use localhost when Strapi runs on
# the host, http://oblak-otel-collector:4318 when it runs in Docker.
# Leave empty to disable telemetry entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=oblak-backend
OBLAK_ENV=development

# --- Telemetry query API (reads from ClickHouse) ---------------------------
# Must match observability/.env
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=otel
CLICKHOUSE_USER=oblak
CLICKHOUSE_PASSWORD=change-this-clickhouse-password

# --- Alerting ---------------------------------------------------------------
# How often alert rules are evaluated against the telemetry store (min 15s).
ALERT_EVAL_INTERVAL_SECONDS=60
# Set to false to stop evaluating rules entirely.
ALERTS_ENABLED=true

# --- Brod (Container Service) ----------------------------------------------
BROD_URL=http://localhost:8083
BROD_API_KEY=

# --- Tefter (Database Service) ---------------------------------------------
TEFTER_URL=http://localhost:8084
TEFTER_API_KEY=

# --- Vrata (Gateway) ---------------------------------------------------------
VRATA_URL=http://localhost:8085
VRATA_API_KEY=
