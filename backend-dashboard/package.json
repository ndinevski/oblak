{
  "name": "oblak-backend-dashboard",
  "version": "1.0.0",
  "description": "Strapi backend for Oblak Cloud Dashboard",
  "private": true,
  "scripts": {
    "develop": "node --require ./instrumentation.cjs ./node_modules/.bin/strapi develop",
    "start": "node --require ./instrumentation.cjs ./node_modules/.bin/strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@strapi/plugin-cloud": "^5.4.2",
    "@strapi/plugin-users-permissions": "^5.4.2",
    "@strapi/provider-email-nodemailer": "^5.52.1",
    "@strapi/strapi": "^5.4.2",
    "@types/nodemailer": "^7.0.5",
    "nodemailer": "^7.0.12",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.3.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.27.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  },
  "license": "MIT"
}
