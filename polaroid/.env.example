# Polaroid (Immich) Configuration

# Immich version tag
IMMICH_VERSION=release

# Polaroid API port (Immich server)
POLAROID_PORT=2283

# Upload storage location (bind mount to host filesystem).
#
# Set this to an ABSOLUTE path. Docker Compose does not expand "~", and a
# relative path is resolved against this directory. Never point it at /tmp:
# that is tmpfs on most distros, so the whole library is lost on reboot while
# the database still references the files, and Immich then refuses to start.
UPLOAD_LOCATION=/var/lib/oblak/polaroid/library

# Database credentials (separate Postgres instance with pgvecto.rs)
DB_USERNAME=polaroid
DB_PASSWORD=change-this-secret-password
DB_DATABASE_NAME=polaroid
