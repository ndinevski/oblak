# Polaroid (Immich) Configuration

# Immich version tag
IMMICH_VERSION=release

# Polaroid API port (Immich server)
POLAROID_PORT=2283

# Upload storage location (bind mount to host filesystem)
# Default: ~/.oblak/polaroid/library
# Override with absolute path for custom location
# UPLOAD_LOCATION=/data/polaroid/library

# Database credentials (separate Postgres instance with pgvecto.rs)
DB_USERNAME=polaroid
DB_PASSWORD=change-this-secret-password
DB_DATABASE_NAME=polaroid
