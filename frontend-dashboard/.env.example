# Oblak Dashboard (frontend) - environment template
# Copy to .env and adjust. Vite only exposes variables prefixed with VITE_.
#
# Use localhost when you browse the dashboard on the same machine that runs it.
# When reaching the dev server from another machine, replace localhost with the
# host's LAN address (e.g. http://192.168.1.83:1337/api) and add that origin to
# CORS_ORIGINS in backend-dashboard/.env, otherwise the browser blocks the
# requests.

# Strapi backend
VITE_API_URL=http://localhost:1337/api

# Backing services (used for display and direct-invoke examples)
VITE_IMPULS_URL=http://localhost:8080
VITE_SPOMEN_URL=http://localhost:8081
VITE_IZVOR_URL=http://localhost:8082
VITE_POLAROID_URL=http://localhost:2283

# OpenTelemetry collector endpoint for browser telemetry (OTLP/HTTP).
# The browser posts directly, so this must be reachable from the user's
# machine and its origin must be allowed in the collector's CORS config
# (observability/otel-collector/config.yaml). Leave empty to disable RUM.
VITE_OTLP_ENDPOINT=http://localhost:4318
