# --- Vrata (Gateway) --------------------------------------------------------
# Management API port (route table CRUD).
VRATA_API_PORT=8085
# Data-plane proxy port. Point clients and the Izvor VM network layer here.
VRATA_PROXY_PORT=8090

# Where traces, logs and metrics are sent.
OTEL_EXPORTER_OTLP_ENDPOINT=oblak-otel-collector:4317
OBLAK_ENV=development

# Auto-discovery of Brod containers (Vrata keeps a route per running container).
VRATA_BROD_URL=http://brod-api:8083
VRATA_DISCOVERY_INTERVAL_SECONDS=30
VRATA_WORKLOAD_HOST=host.docker.internal
